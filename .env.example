# Opcional. Node carga este archivo solamente si se copia como .env.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/eventia.sqlite
# Para un despliegue con HTTPS: configurar el origen y la cookie segura.
# APP_ORIGIN=https://eventia.example
# COOKIE_SECURE=true
# Caché del catálogo en memoria, en milisegundos. 0 la desactiva.
CATALOG_CACHE_TTL_MS=2000
# Inscripciones por usuario y por IP dentro de la ventana.
REGISTRATION_RATE_LIMIT=20
REGISTRATION_RATE_WINDOW_MS=60000
# Solicitudes de inscripción en curso antes de responder 429.
ADMISSION_LIMIT=16
ADMISSION_RETRY_AFTER=2
# Worker de la bandeja de salida.
OUTBOX_POLL_MS=400
OUTBOX_BACKOFF_MS=500
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_LEASE_MS=30000
